# ─────────────────────────────────────────────────────────────
# Midsummer Colombia — variables de entorno
#
# Copia este archivo a `.env` y completa los valores.
# NUNCA subas `.env` al repositorio.
#
# Regla: todo valor con prefijo PUBLIC_ termina en el bundle del
# navegador y es visible para cualquiera. Solo pon ahí lo que
# sea público por diseño. Los secretos (claves privadas, tokens,
# contraseñas de SMTP) NO van aquí: en Astro con salida estática
# no existe forma de mantenerlos fuera del bundle.
# ─────────────────────────────────────────────────────────────

# Dominio público del sitio. Sin barra final.
# Sin este valor, el build usa el fallback de src/config/site.config.ts.
SITE_URL=https://midsummersolar.co

# Proveedor de contenido activo: "mock" | "wordpress"
# mock      → usa src/lib/cms/providers/mock.ts (prototipo, sin WordPress)
# wordpress → consulta la REST API de WordPress durante el build
CMS_PROVIDER=mock

# ── Solo si CMS_PROVIDER=wordpress ──────────────────────────────
# URL base de la REST API, sin barra final. Incluye ya `/wp-json/wp/v2`.
#
# Desarrollo local (WordPress real, instalado por este repositorio):
#   CMS_API_URL=http://localhost:8080/wp-json/wp/v2
#
# Producción: AÚN NO EXISTE. El subdominio del CMS es solo una propuesta
# pendiente de contratar hosting y de que Midsummer lo apruebe. No lo
# desactives ni lo pongas aquí mientras no haya una URL real.
CMS_API_URL=

# Origen permitido para CORS durante el build. Sin esto, Astro no puede
# consultar una API externa. Lista separada por comas.
CMS_ALLOWED_ORIGINS=

# El build falla si WordPress no responde, en lugar de publicar un sitio
# vacío. Valores: "true" | "false". Recomendado en producción: "true".
CMS_STRICT=true

# Credenciales de lectura por application password (recomendado) o
# Basic auth. Dejar vacío si la API es pública de solo lectura.
CMS_AUTH_USER=
CMS_AUTH_APP_PASSWORD=

# ── Mapa (opcional) ────────────────────────────────────────────
# PROVEEDOR actual: "leaflet" ( adaptable, ver src/lib/map/ )
MAP_PROVIDER=leaflet
# Solo si el proveedor elegido exige clave (MapTiler, Mapbox, Google).
# Con OpenStreetMap no se necesita clave.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
MAP_API_KEY=

# ── Analítica (opcional, requiere consentimiento) ───────────────
# ID de Google Analytics 4 (G-XXXXXXX). Vacío = no se carga nada.
PUBLIC_ANALYTICS_ID=
# ID del contenedor de Google Tag Manager (GTM-XXXXXX).
PUBLIC_GTM_ID=

# Contacto
# Clave pública de Cloudflare Turnstile. Vacío = el formulario funciona
# sin CAPTCHA (solo honeypot + trampa de tiempo), menos seguro.
PUBLIC_TURNSTILE_SITE_KEY=
