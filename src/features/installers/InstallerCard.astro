---
/**
 * Tarjeta de instalador.
 *
 * Solo muestra contacto si existe. Un teléfono o correo vacío se marca como
 * pendiente en lugar de imprimir un enlace vacío que no hace nada.
 */
import type { Installer } from '../../lib/cms/types';
import ContentPending from '../../components/content/ContentPending.astro';
import Icon from '../../components/ui/Icon.astro';

interface Props {
  installer: Installer;
}

const { installer } = Astro.props;

const isPending = (value: readonly string[]) =>
  value.length === 0 || value.some((item) => item.startsWith('CONTENIDO'));

const hasContact = Boolean(installer.email || installer.phone || installer.website);
---

<article class="flex h-full flex-col rounded-lg border border-border bg-surface p-5">
  {installer.logo ? (
    <img
      src={installer.logo.url}
      alt={installer.logo.alt}
      width={installer.logo.width ?? undefined}
      height={installer.logo.height ?? undefined}
      loading="lazy"
      decoding="async"
      class="mb-4 h-12 w-auto object-contain"
    />
  ) : (
    <div
      class="mb-4 flex h-12 w-12 items-center justify-center rounded-md bg-brand-50 text-sm font-bold text-accent"
      aria-hidden="true"
    >
      {installer.companyName.charAt(0)}
    </div>
  )}

  <h3 class="text-lg">{installer.companyName}</h3>

  <p class="mt-2 text-sm text-muted-foreground">{installer.summary}</p>

  <div class="mt-4">
    <p class="text-xs font-semibold tracking-wide text-foreground uppercase">
      Cobertura
    </p>
    {isPending(installer.coverage) ? (
      <div class="mt-1.5">
        <ContentPending display="inline" text="Departamentos pendientes" />
      </div>
    ) : (
      <ul class="mt-1.5 flex flex-wrap gap-1.5">
        {installer.coverage.map((item) => (
          <li class="rounded-full bg-neutral-100 px-2.5 py-1 text-xs text-neutral-700">
            {item}
          </li>
        ))}
      </ul>
    )}
  </div>

  {hasContact ? (
    <ul class="mt-5 flex flex-col gap-2 border-t border-border pt-4 text-sm">
      {installer.website && (
        <li>
          <a
            href={installer.website}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-accent no-underline hover:underline"
          >
            Sitio web
            <Icon name="arrow-up-right" class="h-4 w-4" />
          </a>
        </li>
      )}
      {installer.email && (
        <li>
          <a
            href={`mailto:${installer.email}`}
            class="inline-flex items-center gap-1.5 text-accent no-underline hover:underline"
          >
            <Icon name="mail" class="h-4 w-4" />
            {installer.email}
          </a>
        </li>
      )}
    </ul>
  ) : (
    <div class="mt-5 border-t border-border pt-4">
      <ContentPending display="inline" text="Datos de contacto pendientes" />
    </div>
  )}
</article>
