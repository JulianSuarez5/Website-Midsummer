---
/**
 * Página 404.
 *
 * Devuelve un enlace a la portada y a las secciones principales en lugar de
 * un mensaje seco: la mayoría de las visitas a un 404 vienen de un enlace
 * equivocado en un buscador o de un contenido que se movió de sitio.
 */
import BaseLayout from '../components/layout/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { PRIMARY_NAV } from '../config/nav.config';
import { buildMeta } from '../lib/seo/meta';

const path = '/404/';

const meta = buildMeta({
  path,
  title: 'Página no encontrada',
  description: 'La página que buscas no existe o cambió de dirección.',
  seo: { noindex: true },
});

const shortcuts = PRIMARY_NAV.filter((item) => item.href !== '/');
---

<BaseLayout meta={meta} path={path}>
  <Container class="py-20 sm:py-28">
    <p class="text-sm font-semibold tracking-wide text-accent">Error 404</p>
    <h1 class="mt-3 max-w-3xl text-3xl sm:text-4xl">Esta página no existe</h1>
    <p class="mt-4 max-w-prose text-lg text-muted-foreground">
      Puede que el enlace esté mal escrito o que el contenido se haya movido. Estas son
      las secciones del sitio:
    </p>

    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      {shortcuts.map((item) => (
        <li>
          <a
            href={item.href}
            class="block rounded-lg border border-border bg-surface p-4 transition-colors hover:border-accent"
          >
            <span class="font-medium">{item.label}</span>
            <span class="mt-1 block text-sm text-muted-foreground">
              {item.description}
            </span>
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-8">
      <a
        href="/"
        class="font-medium text-accent underline underline-offset-2 hover:text-accent-hover"
      >
        Volver a la portada
      </a>
    </p>
  </Container>
</BaseLayout>
