---
/**
 * Listado de noticias.
 *
 * Orden y límite los define el CMS. Sin contenido se muestra el estado vacío:
 * un listado de noticias con cero artículos es mejor que una fecha inventada.
 */
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import NewsCard from '../../features/news/NewsCard.astro';
import PageHero from '../../sections/PageHero.astro';
import StateBlock from '../../components/content/StateBlock.astro';
import { PRIMARY_NAV } from '../../config/nav.config';
import { buildMeta } from '../../lib/seo/meta';
import { breadcrumbSchema } from '../../lib/seo/jsonld';
import { content } from '../../lib/cms/queries';

const path = '/noticias/';
const navItem = PRIMARY_NAV.find((item) => item.href === path);
const label = navItem?.label ?? 'Noticias';

const meta = buildMeta({
  path,
  title: label,
  description: navItem?.description,
});

const breadcrumb = [
  { name: 'Inicio', path: '/' },
  { name: label, path },
];

const posts = await content.listNews(24);
---

<BaseLayout meta={meta} path={path}>
  <Fragment slot="head">
    <JsonLd data={breadcrumbSchema(breadcrumb)} />
  </Fragment>

  <PageHero title={label} description={navItem?.description} breadcrumb={breadcrumb} />

  <section class="py-14 sm:py-18">
    <Container>
      {posts.length > 0 ? (
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <li>
              <NewsCard post={post} />
            </li>
          ))}
        </ul>
      ) : (
        <StateBlock
          title="Sin noticias publicadas"
          description="Esta sección se completará cuando Midsummer publique novedades de la operación en Colombia."
        />
      )}
    </Container>
  </section>
</BaseLayout>
