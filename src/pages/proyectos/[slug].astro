---
/**
 * Ficha de un proyecto.
 *
 * Los datos sensibles (coordenadas exactas, potencia) solo se muestran si el
 * CMS los trae: la decisión de publicarlos es de Midsummer, no del frontend.
 * `t.project.noCoordinates` deja explícito el motivo cuando faltan.
 */
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import PageHero from '../../sections/PageHero.astro';
import ProjectMap from '../../features/projects/ProjectMap';
import StateBlock from '../../components/content/StateBlock.astro';
import { MAP } from '../../config/map.config';
import { buildMeta } from '../../lib/seo/meta';
import { breadcrumbSchema } from '../../lib/seo/jsonld';
import { content } from '../../lib/cms/queries';
import { toMapPoints } from '../../lib/map/types';
import { t } from '../../lib/i18n';
import type { Project } from '../../lib/cms/types';

export async function getStaticPaths() {
  const projects = await content.listProjects();

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

const path = `/proyectos/${project.slug}/`;

const meta = buildMeta({
  path,
  title: project.title,
  description: project.summary,
  seo: project.seo,
  ogImage: project.image?.url ?? null,
});

const breadcrumb = [
  { name: 'Inicio', path: '/' },
  { name: 'Proyectos', path: '/proyectos/' },
  { name: project.title, path },
];

const hasBody = typeof project.body === 'string' && project.body.trim().length > 0;
const mapPoints = toMapPoints([project]);

/** Filtros de la ficha: solo los que el CMS entregó. */
const facts = [
  { label: t.project.department, value: project.department },
  { label: t.project.location, value: project.municipality },
  { label: t.project.installType, value: project.installType },
  {
    label: t.project.capacity,
    value:
      project.capacityWp === null
        ? null
        : `${project.capacityWp.toLocaleString('es-CO')} Wp`,
  },
  { label: t.project.year, value: project.year === null ? null : String(project.year) },
  { label: 'Estado', value: project.status },
].filter((fact) => fact.value !== null);
---

<BaseLayout meta={meta} path={path}>
  <Fragment slot="head">
    <JsonLd data={breadcrumbSchema(breadcrumb)} />
  </Fragment>

  <PageHero
    title={project.title}
    description={project.summary}
    breadcrumb={breadcrumb}
  />

  {project.image && (
    <Container class="pt-10">
      <img
        src={project.image.url}
        alt={project.image.alt}
        width={project.image.width ?? undefined}
        height={project.image.height ?? undefined}
        decoding="async"
        class="aspect-wide w-full rounded-lg object-cover"
      />
    </Container>
  )}

  <section class="py-14 sm:py-18">
    <Container>
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <div>
          {hasBody ? (
            <div class="prose-content" set:html={project.body} />
          ) : (
            <StateBlock
              title="Proyecto sin descripción"
              description="Midsummer debe publicar la descripción del proyecto, sus características técnicas y el alcance de la instalación."
            />
          )}

          {project.gallery.length > 0 && (
            <ul class="mt-10 grid gap-4 sm:grid-cols-2">
              {project.gallery.map((item) => (
                <li>
                  <img
                    src={item.url}
                    alt={item.alt}
                    width={item.width ?? undefined}
                    height={item.height ?? undefined}
                    loading="lazy"
                    decoding="async"
                    class="aspect-photo w-full rounded-md object-cover"
                  />
                </li>
              ))}
            </ul>
          )}
        </div>

        <aside class="lg:sticky lg:top-24 lg:self-start">
          <h2 class="text-lg">Datos del proyecto</h2>

          {facts.length > 0 ? (
            <dl class="mt-4 space-y-3 text-sm">
              {facts.map((fact) => (
                <div class="flex justify-between gap-4 border-b border-border pb-2">
                  <dt class="text-muted-foreground">{fact.label}</dt>
                  <dd class="text-right font-medium">{fact.value}</dd>
                </div>
              ))}
            </dl>
          ) : (
            <p class="mt-3 text-sm text-muted-foreground">
              Midsummer debe publicar los datos técnicos de este proyecto.
            </p>
          )}

          {mapPoints.length > 0 ? (
            <div class="mt-6">
              <ProjectMap
                client:visible
                providerName={MAP.provider}
                points={mapPoints}
                center={MAP.center}
                zoom={MAP.zoom}
                minZoom={MAP.minZoom}
                maxZoom={MAP.maxZoom}
                bounds={MAP.bounds}
                tileUrl={MAP.tileUrl}
                attribution={MAP.attribution}
                ariaLabel={`Ubicación del proyecto ${project.title}`}
                noPointsMessage={t.project.noCoordinates}
                listFallbackLabel={t.map.fallbackTitle}
              />
            </div>
          ) : (
            <p class="mt-6 text-sm text-muted-foreground">{t.project.noCoordinates}</p>
          )}
        </aside>
      </div>
    </Container>
  </section>
</BaseLayout>
