---
/**
 * Portada.
 *
 * Objetivo de la página: que un visitante que llega por primera vez entienda
 * quién es Midsummer, qué hace y por qué le concierne, y tenga una acción
 * clara. Estructura: propuesta de valor → soluciones → proyectos → mapa →
 * noticias → contacto.
 *
 * Todos los datos vienen del proveedor de contenido, de modo que esta página
 * no contiene cifras ni afirmaciones propias.
 */
import BaseLayout from '../components/layout/BaseLayout.astro';
import CtaSection from '../sections/CtaSection.astro';
import HeroSection from '../sections/HeroSection.astro';
import NewsSection from '../sections/NewsSection.astro';
import ProjectsSection from '../sections/ProjectsSection.astro';
import SolutionsSection from '../sections/SolutionsSection.astro';
import ValuePropsSection from '../sections/ValuePropsSection.astro';
import { content } from '../lib/cms/queries';
import { buildMeta } from '../lib/seo/meta';
import { SITE } from '../config/site.config';
import { MAP } from '../config/map.config';
import { toMapPoints } from '../lib/map/types';
import ProjectMap from '../features/projects/ProjectMap';
import Container from '../components/ui/Container.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { t } from '../lib/i18n';

const [solutions, featuredProjects, news, allProjects] = await Promise.all([
  content.listSolutions(),
  content.listFeaturedProjects(3),
  content.listNews(3),
  content.listProjects(),
]);

const meta = buildMeta({
  path: '/',
  title: `${SITE.name} ${SITE.market} — ${SITE.tagline}`,
  description: SITE.description,
});

const mapPoints = toMapPoints(allProjects);

const valueProps = [
  {
    title: 'Tecnología sin silicio',
    summary:
      'PENDIENTE: MIDSUMMER DEBE APROBAR esta ventaja técnica. No se publica sin confirmación escrita.',
  },
  {
    title: 'Ligero y fácil de instalar',
    summary:
      'PENDIENTE: MIDSUMMER DEBE APROBAR esta característica y, si se cuantifica, sus datos técnicos.',
  },
  {
    title: 'Menor huella de carbono',
    summary:
      'PENDIENTE: MIDSUMMER DEBE ENTREGAR la metodología y las cifras verificables del cálculo.',
  },
  {
    title: 'Acompañamiento local',
    summary:
      'PENDIENTE: MIDSUMMER DEBE DESCRIBIR la red de instaladores y aliados en Colombia.',
  },
];
---

<BaseLayout meta={meta} path="/">
  <HeroSection />

  <ValuePropsSection
    title="Por qué Midsummer en Colombia"
    description="PENDIENTE: MIDSUMMER DEBE PROPORCIONAR el texto introductorio de esta sección."
    items={valueProps}
  />

  <SolutionsSection
    title="Soluciones y productos"
    description="Líneas de producto disponibles en Colombia. Descripciones y especificaciones pendientes de aprobación."
    solutions={solutions}
  />

  <ProjectsSection projects={featuredProjects} />

  {mapPoints.length > 0 && (
    <section class="border-t border-border bg-surface py-16 sm:py-20">
      <Container>
        <SectionHeader
          eyebrow="Presencia en el territorio"
          title={t.map.title}
          description="MIDSUMMER DEBE PROPORCIONAR la ubicación de los proyectos y autorizar la publicación de estas coordenadas."
          level={2}
          class="reveal"
        />
        <div class="mt-8 reveal">
          <ProjectMap
            client:visible
            providerName={MAP.provider}
            points={mapPoints}
            center={MAP.center}
            zoom={MAP.zoom}
            minZoom={MAP.minZoom}
            maxZoom={MAP.maxZoom}
            bounds={MAP.bounds}
            tileUrl={MAP.tileUrl}
            attribution={MAP.attribution}
            ariaLabel="Mapa de Colombia con la ubicación de los proyectos de Midsummer"
            noPointsMessage={t.map.noPoints}
            listFallbackLabel="Ver proyectos como lista"
          />
        </div>
      </Container>
    </section>
  )}

  <NewsSection posts={news} />

  <CtaSection />
</BaseLayout>
